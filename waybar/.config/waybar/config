{
    "output": ["*"],
    "layer": "top", 
    "position": "top", 
    "exclusive": true,
    "passthrough": false,
    "spacing": 5,
    
    "modules-left": ["custom/shutdown", "hyprland/workspaces", "hyprland/window"], 
    "modules-center": ["clock"], 
    "modules-right": ["tray", "pulseaudio", "bluetooth", "network", "group/hardware"], 
    
    // "hyprland/workspaces": {
    //      "format": "{icon}",
    //     //  "format-icons": {
    //     //     "active": "󰹞"
    //     //  }
    // },

    "hyprland/language": {
        "format": "{short}",
        "tooltip-format": "{long}"
    },

    "hyprland/window": {
        "format": "{initialTitle}",
        "tooltip-format": "{title}",
        "rewrite": {
            "(.*)Firefox": "󰈹 Firefox",
            "(.*)VSCodium": "󰈮 VSCodium",
            "(.*)kitty": "󰄛 Kitty",
            "(.*)Zotero": " Zotero",
            "(.*)Microsoft Teams": "󰊻 Teams",
            "(.*)Waiting for(.*)": "󰊻 Teams",
            "(.*)Discord(.*)": " Discord",
            "(.*)Document Viewer(.*)": "󰈙 Document Viewer",
            "(.*)Image Viewer(.*)": "󰈟 Image Viewer",
            "(.*)LocalSend(.*)": " LocalSend",
            "(.*)Cisco Secure Client(.*)": "󱘖 Cisco Secure Client",
            "(.*)QFitsView(.*)": " QFitsView",
            "(.*)Mousepad(.*)": " Mousepad",
            "(.*)Thunar": "󰉋 Thunar"
        },
        "max-length": 50
    },

    "tray": {
        "icon-size": 21,
        "spacing": 10,
        "reverse-direction": true,
        "show-passive-items": true
    },
    "clock": {
        "timezone": "Europe/Berlin",
        "format": " {:%d. %b,  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
                    "mode"          : "year",
                    "mode-mon-col"  : 3,
                    "weeks-pos"     : "left",
                    "on-scroll"     : 1,
                    "format": {
                              "months":     "<span color='#ffead3'><b>{}</b></span>",
                              "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                              "weeks":     "<span color='#99ffdd'><b>{:%W}</b></span>",
                              "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                              "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
                              }
                    },
        "actions":  {
                    "on-click-right": "mode"
                    },
        "cursor": false
    },

    "pulseaudio": {
        "scroll-step": 5, 
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        }
    },

    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "max-length": 50,
        "on-click": "kitty -e bluetui"
    },

    "network": {
        "format": "{ifname}",
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "{essid}\t({signalStrength}%)\n\n󱦲{bandwidthUpBits} 󱦳{bandwidthDownBits}",
        "tooltip-format-ethernet": "{ifname}\n\n󱦲{bandwidthUpBits} 󱦳{bandwidthDownBits}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "on-click": "kitty -e impala"
     },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-icons": ["󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨"],
        "tooltip-format": "{percent}%"
    },
    
    "custom/shutdown":{
    	"tooltip": false,
    	"format": "󰣇",
    	"on-click": "~/MKArch/MKArch_wlogout"
    },

    "group/hardware": {
		"orientation": "horizontal",
        "drawer": {
            "transition-duration": 100,
            "transition-left-to-right": false
        },
		"modules": [
            "battery",
			"cpu",
			"memory"
		]
	},
    
    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format": "{icon} {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{time}"
    },

    "cpu": {
        "interval": 10,
        "format": " {usage}%"
    },

    "memory": {
        "interval": 10,
        "format": "{percentage}% 󰯍{swapPercentage}%",
        "tooltip-format": " {used}/{total}Gb\n\n󰯍 {swapUsed}/{swapTotal}Gb"
    }

}